#
#---------------------------------------------------------------------
#
# Dockerfile for the Open-Air-Interface FlexRIC service
#   Valid for Ubuntu-22.04 (jammy)
#
# Extends: Dockerfile.rc-prb-rrc-release
#
# Description:
#   Builds the nearRT-RIC with both PRB reallocation support and the new
#   KPM metrics extension. All patches from Dockerfile.rc-prb-rrc-release
#   are applied first, then two new KPM patches are applied on top before
#   the FlexRIC build:
#
#   1. xapp_kpm_moni.c  — adds display/log handlers for the new KPM metric
#                         names so the KPM monitor xApp prints them correctly.
#
#   2. sm_kpm.c         — adds emulator stubs for the new KPM metrics so that
#                         the emulator agent (emu-gnb-mono / emu-du) can report
#                         them during offline testing without a real OAI gNB.
#
#   New KPM metrics covered:
#     TB layer  : TB.TotNbrDlInitial, TB.IntialErrNbrDl, TB.TotNbrDl.sum,
#                 TB.ResidualErrNbrDl, TB.TotNbrUlInit, TB.ErrNbrUlInitial,
#                 TB.TotNbrUl.sum, TB.ResidualErrNbrUl
#     RLC layer : DRB.RlcPacketDropRateDl, DRB.PacketLossRateUl, DRB.RlcSduLatencyDl
#     RRC layer : RRC.ConnMean, RRC.ConnMax
#
# Build:
#   docker build \
#     -f /home/lapdk/workspace/oai-v210/helm-flexric/nearrt-ric/Dockerfile.new-kpm-metrics \
#     -t ddocker122/oai-flexric:new-kpm-metrics \
#     /home/lapdk/workspace/oai-v210/helm-flexric
#
#---------------------------------------------------------------------
# BASE IMAGE — build tools + SWIG (shared with Dockerfile.rc-prb-rrc-release)
#---------------------------------------------------------------------
ARG BASE_IMAGE=ubuntu:jammy

FROM $BASE_IMAGE AS oai-flexric-base
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Europe/Paris

# Install build dependencies
RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get upgrade --yes && \
    DEBIAN_FRONTEND=noninteractive apt-get install --yes \
       build-essential \
       libsctp-dev \
       git \
       wget \
       tar \
       m4 \
       automake \
       libtool \
       python3 \
       cmake \
       cmake-curses-gui \
       bison \
       flex \
       gdb \
       libpcre2-dev \
       python3-dev \
       python3-pip \
       gcc-12 \
       g++-12 \
       mold \
       ninja-build && \
    apt-get clean

RUN git clone https://github.com/swig/swig.git && \
    cd swig && \
    git checkout release-4.1 && \
    ./autogen.sh && \
    ./configure --prefix=/usr/ && \
    make -j8 && \
    make install && \
    ldconfig

#---------------------------------------------------------------------
# BUILDER IMAGE
#---------------------------------------------------------------------
FROM oai-flexric-base AS oai-flexric-builder

# ---- Patches from Dockerfile.rc-prb-rrc-release (PRB reallocation / RRC support) ----
COPY xapp-rc-prb-rrc-release/xapp_rc_slice_ctrl.c /tmp/xapp_rc_slice_ctrl.c
COPY nearrt-ric/patches/map_xapps_sockaddr.c /tmp/patches/map_xapps_sockaddr.c
COPY nearrt-ric/patches/sync_ui.c /tmp/patches/sync_ui.c

# ---- New patches: KPM metrics extension ----
# xapp_kpm_moni.c: adds log/display cases for the new metric names.
# sm_kpm.c:        adds emulator random-value stubs for offline testing.
COPY nearrt-ric/patches/examples/xApp/c/monitor/xapp_kpm_moni.c \
     /tmp/patches/xapp_kpm_moni.c
COPY nearrt-ric/patches/examples/emulator/agent/sm_kpm.c \
     /tmp/patches/sm_kpm.c

RUN git clone https://gitlab.eurecom.fr/mosaic5g/flexric && \
    cd flexric && \
    git checkout slicing-spring-of-code && \
    # PRB reallocation patches
    cp /tmp/xapp_rc_slice_ctrl.c examples/xApp/c/ctrl/ && \
    cp /tmp/patches/map_xapps_sockaddr.c src/ric/iApp/map_xapps_sockaddr.c && \
    cp /tmp/patches/sync_ui.c src/xApp/sync_ui.c && \
    # New KPM metrics patches
    cp /tmp/patches/xapp_kpm_moni.c examples/xApp/c/monitor/xapp_kpm_moni.c && \
    cp /tmp/patches/sm_kpm.c examples/emulator/agent/sm_kpm.c && \
    mkdir build && cd build && \
    cmake -DXAPP_MULTILANGUAGE=OFF -DCMAKE_C_COMPILER=gcc-12 -DCMAKE_CXX_COMPILER=g++-12 .. && make -j8 && make install

#---------------------------------------------------------------------
# TARGET IMAGE
#---------------------------------------------------------------------
FROM $BASE_IMAGE AS oai-flexric
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Europe/Paris

# Install runtime dependencies
RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get upgrade --yes && \
    DEBIAN_FRONTEND=noninteractive apt-get install --yes \
       psmisc \
       gpg \
       wget \
       libsctp1 \
       python3 \
       python3-pip \
       netcat-openbsd && \
    apt-get autoremove -y && \
    apt-get autoclean -y

WORKDIR /

COPY --from=oai-flexric-builder \
    /usr/local/lib/flexric/libmac_sm.so \
    /usr/local/lib/flexric/libkpm_sm.so \
    /usr/local/lib/flexric/librlc_sm.so \
    /usr/local/lib/flexric/libslice_sm.so \
    /usr/local/lib/flexric/libtc_sm.so \
    /usr/local/lib/flexric/libgtp_sm.so \
    /usr/local/lib/flexric/libpdcp_sm.so \
    /usr/local/lib/flexric/librc_sm.so \
    /usr/local/lib/flexric/

COPY --from=oai-flexric-builder \
    /flexric/build/src/xApp/libe42_xapp_shared.so \
    /flexric/build/src/xApp/

COPY --from=oai-flexric-builder \
    /flexric/build/examples/ric/nearRT-RIC /usr/local/bin/nearRT-RIC

# Copy xApps (includes updated xapp_kpm_moni and emulator agent)
COPY --from=oai-flexric-builder \
    /flexric/build/examples/xApp /usr/local/flexric/xApp

RUN ldconfig && \
    echo "--- Check shared objects dependencies for executable nearRT-RIC ---" && \
    ldd /usr/local/bin/nearRT-RIC && \
    echo "--- Check shared objects dependencies for xApp shared library ---" && \
    ldd /flexric/build/src/xApp/libe42_xapp_shared.so && \
    echo "--- Check shared objects dependencies for flexric shared libraries ---" && \
    ldd /usr/local/lib/flexric/*.so

## E2
EXPOSE 36421/sctp
## E42
EXPOSE 36422/sctp

# CMD ["stdbuf", "-o0", "nearRT-RIC"]
